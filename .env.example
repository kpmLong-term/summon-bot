# Telegram credentials from @BotFather. Never commit the real .env.
BOT_TOKEN=
OWNER_ID=
OWNER_PANEL_PASSWORD=

# Primary game data: PostgreSQL in production, SQLite when unset.
DATABASE_URL=
DATA_DIR=./data
SQLITE_PATH=

# Optional MongoDB mirror for audit events only (game data stays in SQL).
MONGO_URI=
MONGO_DB_NAME=summon_bot

# Live feed channel (bot must be able to post). Negative id for channels.
LOG_CHANNEL_ID=

# Kurigram MTProto (optional).
API_ID=
API_HASH=
SESSION_STRING=

WEBHOOK_URL=
WEBHOOK_SECRET=
WEBAPP_URL=
HOST=0.0.0.0
PORT=8080

# Hit /ping every KEEPALIVE_SECONDS (set to your public https://host/ping on Render/Railway).
KEEPALIVE_URL=
KEEPALIVE_SECONDS=300

PREMIUM_CHAT_ID=
PREMIUM_STAR_PRICE=75
VAULT_STAR_PRICE=25
BUTTON_EMOJI_ID=

SPAWN_EVERY=100
SPAWN_SECONDS=90
STARTING_BALANCE=500
DAILY_REWARD=5000
REFRESH_PRICE=10000
HINT_PRICE=50
SUPPORT_URL=

BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=14
INACTIVE_DAYS=90
MAINTENANCE_INTERVAL_HOURS=24
HEARTBEAT_MINUTES=0
TAGALL_LIMIT=40

AUTO_RESTART_MINUTES=0
RESTART_DELAY_SECONDS=10
